{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.preload.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/plugins/*/manifest.ts",
    "src/plugins/*/types.ts"
  ]
}
