{
  "name": "lacritomato-mini-petdex",
  "version": "0.1.0",
  "private": true,
  "description": "LacriTomato Mini Windows desktop pet platform",
  "author": "LacriTomato",
  "main": "dist/src/main/app.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.lacritomato.petdex",
    "productName": "LacriTomato Mini",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "*.traineddata",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/pet/app-icon.ico"
    }
  }
}
